# Askly — Firebase Web App Configuration Template
# Copy this file to .env.local and populate with your Firebase Project Web App credentials from:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional. Used for QR codes and copy-link. Set this on Vercel to your production origin.
# If unset, deployed hosts use window.location.origin. Localhost falls back to https://askly-sand.vercel.app
# so phones never receive a localhost QR.
VITE_PUBLIC_APP_URL=https://askly-sand.vercel.app

# Firebase Console (not an env var): enable Authentication → Sign-in method → Anonymous
# so participants can vote. Firestore vote rules require request.auth != null.
